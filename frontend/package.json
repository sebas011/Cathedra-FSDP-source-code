{
  "name": "cathedra-fsdp",
  "private": true,
  "version": "0.5.21",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --no-experimental-webstorage node_modules/vitest/vitest.mjs run --config vitest.config.ts --configLoader runner",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html",
    "test:coverage": "node --no-experimental-webstorage node_modules/vitest/vitest.mjs run --config vitest.config.ts --configLoader runner --coverage"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "dom-accessibility-api": "0.5.16"
  }
}
